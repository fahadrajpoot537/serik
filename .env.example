APP_NAME=Serik
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Production MUST use:
# APP_ENV=production
# APP_DEBUG=false
# Production canonical domain (non-www). Used for redirects, canonical tags, and sitemaps.
CANONICAL_URL=https://serik.ca
FORCE_ROOT_URL=https://serik.ca
FORCE_SCHEMA=https

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=serik
DB_USERNAME=root
DB_PASSWORD=

QUEUE_CONNECTION=database
# Production: CACHE_STORE=redis (Memurai) — file cache is local-dev only
CACHE_STORE=file
# Production: SESSION_DRIVER=redis or database
SESSION_DRIVER=file
# SESSION_SECURE_COOKIE=true   # auto-true when APP_URL is https://
# SESSION_SAME_SITE=lax
# SESSION_HTTP_ONLY=true

# Memurai / Redis (production — set CACHE_STORE=redis on IIS; never downgrade for local file cache)
# REDIS_CLIENT=phpredis
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_DB=0
# REDIS_CACHE_DB=1
# REDIS_TIMEOUT=2.0
# REDIS_READ_TIMEOUT=2.0
# REDIS_PERSISTENT=false
# REDIS_QUEUE_RETRY_AFTER=360

# Security headers (SerikSecurityHeadersMiddleware)
# SERIK_SECURITY_HEADERS=true
# SERIK_HSTS=true
# SERIK_CSP=true
# If overriding SERIK_CSP_POLICY, include: worker-src 'self' blob: https:; (required for MapLibre markers)
# SERIK_PROPERTY_DETAIL_TTL=1800
# SERIK_HOMEPAGE_TTL=7200
# SERIK_FRAGMENT_TTL=3600
# SERIK_FEATURED_TTL=900
# SERIK_COUNTS_TTL=3600
# SERIK_PLACE_SEARCH_TTL=86400
# SERIK_RELATED_TTL=900
# SERIK_CACHE_WARM_EXTENDED=true
# SERIK_CACHE_WARM_ON_OPTIMIZE=true
# SERIK_SEARCH_SYNC_BATCH=50
# Dual-lane + imports workers (database or redis/Memurai queue driver)
# SERIK_QUEUE_HIGH=high
# SERIK_QUEUE_DEFAULT=default
# SERIK_QUEUE_IMAGES=images
# SERIK_QUEUE_IMPORTS=imports
# SERIK_QUEUE_LOW=low
# SERIK_QUEUE_SEARCH=low
# SERIK_QUEUE_SEARCH_INDEX=search-index
# SERIK_QUEUE_CACHE_REFRESH=cache-refresh
# SERIK_QUEUE_GHL=ghl
# SERIK_QUEUE_EMAILS=emails
# SERIK_QUEUE_NOTIFICATIONS=notifications
# SERIK_QUEUE_CRITICAL=critical
# Orchestration / self-heal (additive)
# SERIK_QUEUE_ORCHESTRATION=true
# SERIK_QUEUE_STALE_RESERVED=900
# SERIK_QUEUE_AUTO_REQUEUE_FAILED=true
# SERIK_QUEUE_HEAL_EVERY=5
# After deploy: touch storage/framework/queue-restart.flag (deploy script does this)
# Prefer Memurai/Redis for locks + queues in production:
# QUEUE_CONNECTION=redis
# CACHE_STORE=redis

SCOUT_DRIVER=meilisearch
# Production Meilisearch host (Memurai/Meili assumed running on the Windows server)
MEILISEARCH_HOST=http://127.0.0.1:7700
MEILISEARCH_KEY=
# SCOUT_QUEUE=false  — keep false; PropertySearchSync + SearchBatchJob already defer HTTP indexing

GEOCODING_PROVIDER=mapbox
MAPBOX_ACCESS_TOKEN=
GOOGLE_MAPS_GEOCODING_API_KEY=

# Geo block: public site only for listed ISO country codes (admin + map APIs bypass).
# Localhost/private IPs are always allowed for development.
GEO_BLOCK_ENABLED=true
GEO_BLOCK_ALLOWED_COUNTRIES=US,CA,PK
GEO_BLOCK_BYPASS_IPS=

# Mail (Botble Admin → Settings → Email can override)
MAIL_MAILER=resend
MAIL_FROM_ADDRESS=info@serik.ca
MAIL_FROM_NAME="${APP_NAME}"
RESEND_API_KEY=
RESEND_VERIFIED_DOMAINS=serik.ca
RESEND_FORCE_SANDBOX_FROM=false

# GoHighLevel — Contact Us, property inquiry, and website registration sync
GOHIGHLEVEL_ENABLED=true
GOHIGHLEVEL_API_TOKEN=
GOHIGHLEVEL_LOCATION_ID=
# GOHIGHLEVEL_BASE_URL=https://services.leadconnectorhq.com
# GOHIGHLEVEL_API_VERSION=2021-07-28
# MLS → Showings (contact custom fields) enterprise sync — dedicated ghl queue
# GOHIGHLEVEL_MLS_SYNC_ENABLED=true
# GOHIGHLEVEL_MLS_PROCESS_AT=05:15
# GOHIGHLEVEL_MLS_BATCH_SIZE=100
# GOHIGHLEVEL_WEBHOOK_SECRET=
# GOHIGHLEVEL_WEBHOOK_IDEMPOTENCY=true
# GOHIGHLEVEL_WEBHOOK_TIMESTAMP_CHECK=false
# GOHIGHLEVEL_CIRCUIT_BREAKER=true
# GOHIGHLEVEL_CIRCUIT_THRESHOLD=5
# GOHIGHLEVEL_CIRCUIT_COOLDOWN=60
# SERIK_QUEUE_GHL=ghl
# Worker: php artisan queue:work --queue=ghl --sleep=1 --tries=8
# Webhook URL: POST /webhooks/gohighlevel
# Monitor: php artisan serik:ghl:status --json

# TREB / AMP live fallback (also accepts TREB_AUTH alias in config/treb.php)
TRREB_AUTH=
TRREB_AUTH1=
# Isolated Archive sold feed (14-year VOW) — used ONLY by serik:treb-archive-import
TRREB_AUTH2=
# Optional override (defaults to AMP Property OData)
# TREB_ARCHIVE_ODATA_URL=https://query.ampre.ca/odata/Property
# Enterprise archive importer tuning:
# TREB_ARCHIVE_CHUNK_SIZE=200
# TREB_ARCHIVE_PAGES_PER_JOB=15
# TREB_ARCHIVE_MAX_SECONDS=90
# TREB_ARCHIVE_MIN_SLEEP_MS=50
# TREB_ARCHIVE_MAX_SLEEP_MS=5000
# TREB_ARCHIVE_CHAIN_WHEN_MORE=true
# TREB_ARCHIVE_PARALLEL=true
# TREB_ARCHIVE_MAX_PARALLEL=4
# TREB_ARCHIVE_ADAPTIVE_CHUNK=true
# Worker: php artisan queue:work --queue=imports --sleep=1 --tries=5
# (keep existing high/default/low workers unchanged)
# Health: php artisan serik:treb-archive-health --benchmark
